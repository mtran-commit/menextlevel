modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
ADMIN_TRANSFER_SECRET = "66d8e1a975ac4e377785d2583f50a39a0da303255cfae16c335f09ae7714a82c"

[objectStorage]
defaultBucketID = "replit-objstore-6a27799e-9c26-4afc-9cc9-c44d8ca7742c"
